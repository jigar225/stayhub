# Copy to .env and supply private local values. Never commit .env.
POSTGRES_USER=stayhub
POSTGRES_DB=stayhub
POSTGRES_PASSWORD=
JWT_SECRET=
TRUSTED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SEED_GUEST_EMAIL=
SEED_GUEST_PASSWORD=
SEED_GUEST_NAME=
SEED_HOST_EMAIL=
SEED_HOST_PASSWORD=
SEED_HOST_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Private local S3-compatible storage; supply random credentials.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=http://storage:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=stayhub-photos
TEST_S3_BUCKET=stayhub-photos-test
S3_REGION=us-east-1

# Optional outside Compose; manifest is read-only local licensed content.
DEMO_CONTENT_MANIFEST=/demo-content/assets/manifest.json

# Explicit local opt-in only; clock controls are disabled by default.
DEMO_MODE=false

# Optional server-only Geoapify autocomplete. Empty key keeps manual address/pin
# entry usable. Never put this key in VITE_* variables or frontend build settings.
# Supply privately in .env; deployment reads these fields from the app secret.
GEOAPIFY_API_KEY=
# Aggregate attempted requests per UTC day, including failed calls; range 1..3000.
# Reserve headroom for this key's other uses; default 2800.
GEOAPIFY_DAILY_BUDGET=2800
